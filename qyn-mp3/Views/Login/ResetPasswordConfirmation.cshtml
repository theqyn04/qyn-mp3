@{
    ViewData["Title"] = "Password Reset Successful";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/login.css" rel="stylesheet" />
</head>
<body>
    <div class="login-container">
        <div class="logo">
            <img src="/image/logo/logo.jpg" alt="Logo" class="logo-img" />
        </div>

        <h1>Password Reset</h1>
        <p>Your password has been changed successfully. You can now log in with your new credentials.</p>

        <a asp-action="Login" asp-controller="Login" class="otp-button">Go to Login</a>
    </div>
</body>
</html>
