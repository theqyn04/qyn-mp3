@{
    ViewData["Title"] = "Email Sent";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/login.css" rel="stylesheet" />
</head>
<body>
    <div class="login-container">
        <div class="logo">
            <img src="/image/logo/logo.jpg" alt="Logo" class="logo-img" />
        </div>

        <h1>Check your email</h1>
        <p>We’ve sent a code to your email address if it exists in our system. Please check your inbox.</p>

        <a asp-action="Login" asp-controller="Login" class="otp-button">Back to Login</a>
    </div>
</body>
</html>
