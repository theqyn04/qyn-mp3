@model qyn_mp3.Models.ViewModels.SignUpViewModel

@{
    ViewData["Title"] = "Sign Up";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - QYN MP3</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="~/css/login.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <div class="login-container">
        <div class="logo">
            <img src="/image/logo/logo.jpg" alt="QYN MP3 Logo" class="logo-img" />
        </div>

        <h1>Sign up for QYN MP3</h1>

        <!-- Form gửi OTP -->
        <form id="sendOtpForm" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label asp-for="Email">Email</label>
                <div class="email-otp-row">
                    <input asp-for="Email" id="emailInput" class="form-control" placeholder="Email" />
                    <button type="submit" id="sendOtpBtn" class="send-otp-btn">Gửi OTP</button>
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
                <div id="otpMessage" style="display:none; margin-top: 5px;"></div>
            </div>
        </form>

        <!-- Form đăng ký -->
        <form asp-action="SignUp" method="post" id="signUpForm" style="display:none;">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label asp-for="UserName">Username</label>
                <input asp-for="UserName" placeholder="Username" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FullName">Full Name</label>
                <input asp-for="FullName" placeholder="Full Name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" style="display:none;">Email</label>
                <input asp-for="Email" id="emailInputSignUp" style="display:none;" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" placeholder="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Otp">OTP</label>
                <input asp-for="Otp" placeholder="Enter OTP" />
                <span asp-validation-for="Otp" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Sign Up</button>
        </form>

        <div class="divider">or</div>

        <div class="signup-link">
            Already have an account? <a asp-controller="Login" asp-action="Login">Log in to QYN MP3</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).ready(function () {
            // Xử lý gửi OTP
            $('#sendOtpForm').on('submit', function (e) {
                e.preventDefault();

                const email = $('#emailInput').val();
                const messageDiv = $('#otpMessage');
                messageDiv.hide();

                if (!email) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Vui lòng nhập email trước.',
                        confirmButtonColor: '#e50914'
                    });
                    return false;
                }

                $.ajax({
                    url: '@Url.Action("SendSignUpOtp", "Login")',
                    type: 'POST',
                    data: JSON.stringify({ email: email }),
                    contentType: 'application/json',
                    headers: {
                        'RequestVerificationToken': $('#sendOtpForm input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (data) {
                        if (data.success) {
                            messageDiv.text('OTP đã được gửi đến email của bạn.').removeClass('text-danger').addClass('text-success').show();
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: 'OTP đã được gửi đến email của bạn. Vui lòng nhập thông tin để đăng ký.',
                                confirmButtonColor: '#e50914'
                            });
                            // Hiển thị form đăng ký
                            $('#sendOtpForm').hide();
                            $('#signUpForm').show();
                            // Điền email vào form đăng ký (ẩn)
                            $('#emailInputSignUp').val(email);
                        } else {
                            messageDiv.text(data.message || 'Gửi OTP thất bại.').removeClass('text-success').addClass('text-danger').show();
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi',
                                text: data.message || 'Gửi OTP thất bại.',
                                confirmButtonColor: '#e50914'
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Lỗi AJAX:', status, error);
                        messageDiv.text('Đã xảy ra lỗi khi gửi OTP.').removeClass('text-success').addClass('text-danger').show();
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: 'Đã xảy ra lỗi khi gửi OTP.',
                            confirmButtonColor: '#e50914'
                        });
                    }
                });

                return false;
            });

            // Xử lý form đăng ký
            $('#signUpForm').on('submit', function (e) {
                e.preventDefault();

                $.ajax({
                    url: '@Url.Action("SignUp", "Login")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (data) {
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Đăng ký thành công',
                                text: 'Bạn đã đăng ký thành công! Vui lòng đăng nhập.',
                                confirmButtonColor: '#e50914'
                            }).then(() => {
                                window.location.href = '@Url.Action("Login", "Login")';
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi',
                                text: data.message || 'Đăng ký thất bại.',
                                confirmButtonColor: '#e50914'
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Lỗi AJAX:', status, error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: 'Đã xảy ra lỗi khi đăng ký.',
                            confirmButtonColor: '#e50914'
                        });
                    }
                });

                return false;
            });
        });
    </script>
</body>
</html>