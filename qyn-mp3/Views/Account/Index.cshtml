@model ApplicationUser

@{
    ViewData["Title"] = "My Account";
    Layout = "/Views/Shared/_Layout.cshtml"; // Sử dụng layout chung
}

<div class="account-page">
    <div class="account-header">
        @if (!string.IsNullOrEmpty(Model.ProfileImage))
        {
            <img src="@Model.ProfileImage" class="account-avatar" alt="Profile Image" />
        }
        else
        {
            <div class="account-avatar" style="background-color: var(--bubble-pink); display: flex; align-items: center; justify-content: center; font-size: 40px; color: white;">
                @Model.FullName?[0]
            </div>
        }
        <div>
            <h1 class="account-title">@Model.FullName</h1>
        </div>
    </div>

    <div class="account-details">
        <div class="detail-row">
            <div class="detail-label">Email</div>
            <div class="detail-value">@Model.Email</div>
        </div>
        <div class="detail-row">
            <div class="detail-label">Username</div>
            <div class="detail-value">@Model.UserName</div>
        </div>
        <div class="detail-row">
            <div class="detail-label">Phone</div>
            <div class="detail-value">@(Model.PhoneNumber ?? "Not set")</div>
        </div>
        <button class="edit-button" onclick="location.href='@Url.Action("Edit", "Account")'">
            <i class="fas fa-edit"></i> Edit Profile
        </button>
    </div>

    <h2 style="color: var(--aqua-blue); margin-bottom: 20px;">Your Stats</h2>
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-number">128</div>
            <div class="stat-label">Songs Played</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">42</div>
            <div class="stat-label">Playlists</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">12</div>
            <div class="stat-label">Following</div>
        </div>
    </div>
</div>
@section Styles {
    <link href="~/css/account.css" rel="stylesheet" />
}